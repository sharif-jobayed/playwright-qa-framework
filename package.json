{
  "name": "playwright-qa-framework",
  "version": "1.0.0",
  "description": "E2E + API test automation framework: Playwright Test, TypeScript, Page Object Model, fixtures, CI.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:chromium": "playwright test --project=chromium",
    "test:headless": "PW_HEADED=0 playwright test",
    "test:headed": "PW_HEADED=1 playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "artifacts": "python3 scripts/generate-manual-artifacts.py"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "allure-playwright": "^3.4.1",
    "typescript": "^5.9.0"
  }
}
